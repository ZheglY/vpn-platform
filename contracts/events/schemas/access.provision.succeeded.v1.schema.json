{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpn-platform.invalid/schemas/access.provision.succeeded.v1.schema.json",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "correlation_id", "causation_id", "aggregate_type", "aggregate_id", "aggregate_sequence", "partition_key", "data"],
  "additionalProperties": false,
  "properties": {
    "event_id": {"type": "string", "format": "uuid"}, "event_type": {"const": "access.provision.succeeded.v1"}, "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"}, "producer": {"const": "provisioning-service"},
    "correlation_id": {"type": "string", "format": "uuid"}, "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "aggregate_type": {"const": "credential"}, "aggregate_id": {"type": "string", "format": "uuid"}, "aggregate_sequence": {"type": "integer", "minimum": 1},
    "partition_key": {"type": "string", "pattern": "^credential:[0-9a-fA-F-]{36}$"}, "data": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "endpoint": {"type": "object", "required": ["node_id", "role", "address", "port", "server_name", "reality_public_key", "short_id", "label"], "additionalProperties": false, "properties": {
      "node_id": {"type": "string", "format": "uuid"}, "role": {"enum": ["primary", "failover"]}, "address": {"type": "string", "minLength": 1, "maxLength": 255},
      "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "server_name": {"type": "string", "minLength": 1, "maxLength": 255},
      "reality_public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}, "short_id": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{2}){0,8}$"},
      "spider_x": {"type": "string", "maxLength": 255}, "label": {"type": "string", "minLength": 1, "maxLength": 64}
    }},
    "result": {"type": "object", "required": ["operation_id", "credential_id", "applied_revision", "status", "assigned_node_ids", "endpoints", "applied_at"], "additionalProperties": false, "properties": {
      "operation_id": {"type": "string", "format": "uuid"}, "credential_id": {"type": "string", "format": "uuid"}, "applied_revision": {"type": "integer", "minimum": 1},
      "status": {"enum": ["active", "degraded"]}, "assigned_node_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
      "endpoints": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/endpoint"}},
      "applied_at": {"type": "string", "format": "date-time"}
    }}
  }
}
