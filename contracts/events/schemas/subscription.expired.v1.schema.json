{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpn-platform.invalid/schemas/subscription.expired.v1.schema.json",
  "$defs": {
    "terminalData": {
      "type": "object", "required": ["subscription_id", "user_id", "reason", "effective_at"], "additionalProperties": false,
      "properties": {
        "subscription_id": {"type": "string", "format": "uuid"}, "user_id": {"type": "string", "format": "uuid"},
        "reason": {"const": "expired"}, "affected_period_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
        "effective_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "correlation_id", "causation_id", "aggregate_type", "aggregate_id", "partition_key", "data"],
  "additionalProperties": false,
  "properties": {
    "event_id": {"type": "string", "format": "uuid"}, "event_type": {"const": "subscription.expired.v1"}, "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"}, "producer": {"const": "subscription-service"},
    "correlation_id": {"type": "string", "format": "uuid"}, "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "aggregate_type": {"const": "subscription"}, "aggregate_id": {"type": "string", "format": "uuid"},
    "partition_key": {"type": "string", "pattern": "^user:[0-9a-fA-F-]{36}$"}, "data": {"$ref": "#/$defs/terminalData"}
  }
}
