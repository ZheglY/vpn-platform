{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpn-platform.invalid/schemas/access.provision.failed.v1.schema.json",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "correlation_id", "causation_id", "aggregate_type", "aggregate_id", "partition_key", "data"],
  "additionalProperties": false,
  "properties": {
    "event_id": {"type": "string", "format": "uuid"}, "event_type": {"const": "access.provision.failed.v1"}, "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"}, "producer": {"const": "provisioning-service"},
    "correlation_id": {"type": "string", "format": "uuid"}, "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "aggregate_type": {"const": "credential"}, "aggregate_id": {"type": "string", "format": "uuid"},
    "partition_key": {"type": "string", "pattern": "^credential:[0-9a-fA-F-]{36}$"}, "data": {"$ref": "#/$defs/failure"}
  },
  "$defs": {"failure": {"type": "object", "required": ["operation_id", "credential_id", "failed_revision", "failure_scope", "terminal", "reason_code", "failed_at"], "additionalProperties": false, "properties": {
    "operation_id": {"type": "string", "format": "uuid"}, "credential_id": {"type": "string", "format": "uuid"}, "failed_revision": {"type": "integer", "minimum": 1},
    "failure_scope": {"enum": ["primary", "failover", "all", "unknown"]}, "terminal": {"type": "boolean"}, "reason_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "pending_node_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}}, "failed_at": {"type": "string", "format": "date-time"}
  }}}
}
