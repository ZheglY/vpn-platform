# Copy to .env for local Compose. Values are placeholders, not production secrets.
POSTGRES_USER=vpn_local
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=vpn_platform
POSTGRES_PORT=5432
IDENTITY_DB_PASSWORD=replace-with-random-local-identity-password
CATALOG_DB_PASSWORD=replace-with-random-local-catalog-password
BILLING_DB_PASSWORD=replace-with-random-local-billing-password
SUBSCRIPTION_DB_PASSWORD=replace-with-random-local-subscription-password
ACCESS_DB_PASSWORD=replace-with-random-local-access-password
PROVISIONING_DB_PASSWORD=replace-with-random-local-provisioning-password
NOTIFICATION_DB_PASSWORD=replace-with-random-local-notification-password
ADMIN_DB_PASSWORD=replace-with-random-local-admin-password
ADMIN_MIGRATOR_DB_PASSWORD=replace-with-random-local-admin-migrator-password
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-local-redis-password
KAFKA_PORT=9094
IDENTITY_HTTP_PORT=8080
TELEGRAM_HTTP_PORT=8081
TELEGRAM_API_HTTP_PORT=8082
CATALOG_HTTP_PORT=8083
BILLING_HTTP_PORT=8084
YOOKASSA_HTTP_PORT=8085
SUBSCRIPTION_HTTP_PORT=8086
ACCESS_HTTP_PORT=8087
PROVISIONING_HTTP_PORT=8088
TELEGRAM_INTERNAL_HTTP_PORT=8090
NOTIFICATION_HTTP_PORT=8091
ADMIN_HTTP_PORT=8092
PRIMARY_NODE_AGENT_HTTP_PORT=18443
PRIMARY_VPN_PORT=1443
FAILOVER_NODE_AGENT_HTTP_PORT=28443
FAILOVER_VPN_PORT=2443
ACCESS_CREDENTIAL_KEY_BASE64=replace-with-base64-encoded-32-byte-active-key
ACCESS_TOKEN_HMAC_KEY_BASE64=replace-with-different-base64-encoded-32-byte-key
ACCESS_TOKEN_HMAC_KEY_VERSION=1
# Rotation overlap example: 1:<old-base64>,2:<new-base64>. Keep at most four versions.
ACCESS_TOKEN_HMAC_KEYS=
ACCESS_PUBLIC_IP_RATE_LIMIT=120
ACCESS_PUBLIC_TOKEN_RATE_LIMIT=30
SUBSCRIPTION_PUBLIC_BASE_URL=https://127.0.0.1:8087
HAPP_PROFILE_TITLE=VPN Platform
HAPP_SUPPORT_URL=https://example.invalid/support
FAKE_TELEGRAM_SEND_DELAY=250ms
TELEGRAM_WEBHOOK_SECRET=replace-with-random-local-webhook-secret
TELEGRAM_BOT_TOKEN=replace-with-local-fake-bot-token
TERMS_URL=https://example.invalid/terms/terms-v1
CATALOG_SEED_PLAN_ID=vpn-30d-v1
CATALOG_SEED_NAME=VPN 30 days
CATALOG_SEED_AMOUNT_MINOR=29900
CATALOG_SEED_CURRENCY=RUB
CATALOG_SEED_REGIONS=ru-test
YOOKASSA_SHOP_ID=test-shop
YOOKASSA_SECRET_KEY=replace-with-local-fake-yookassa-key
PAYMENT_RETURN_URL=https://example.invalid/payment-return
# Parent-based root trace sampling ratio for local observability (0..1).
OTEL_TRACES_SAMPLER_ARG=0.1
# Retention commands are report-only unless explicitly switched to false.
RETENTION_DRY_RUN=true
RETENTION_BATCH_SIZE=500
RETENTION_MAX_DELETE=5000
BILLING_WEBHOOK_RETENTION_DAYS=30
ACCESS_SECURITY_AUDIT_RETENTION_DAYS=365
PROVISIONING_DIAGNOSTIC_RETENTION_DAYS=30
NOTIFICATION_DLQ_RETENTION_DAYS=30
ADMIN_AUDIT_RETENTION_DAYS=365
# Backup output defaults to tmp/ on the D: workspace. Production overrides it
# with an encrypted off-host target and an identity supplied by the key owner.
BACKUP_ARTIFACT_DIR=./tmp/backup-artifacts
BACKUP_UID=65532
BACKUP_GID=65532
